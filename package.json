{
  "name": "flightlead-ai",
  "version": "0.1.0",
  "private": true,
  "description": "MVP SMS enrollment agent for independent flight schools",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/formbody": "^8.0.0",
    "@supabase/supabase-js": "^2.57.0",
    "dotenv": "^17.0.0",
    "fastify": "^5.5.0",
    "openai": "^6.0.0",
    "twilio": "^5.10.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "packageManager": "pnpm@11.19.0"
}
