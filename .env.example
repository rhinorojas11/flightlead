# HTTP
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
PUBLIC_BASE_URL=https://your-public-tunnel.example

# OpenAI
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-5-mini

# Supabase (server-side service role only; never expose this key to a browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me

# Twilio
TWILIO_ACCOUNT_SID=AC_replace_me
TWILIO_AUTH_TOKEN=replace-me
TWILIO_VALIDATE_SIGNATURES=true

# Qualification
HOT_LEAD_THRESHOLD=8
RECENT_MESSAGE_LIMIT=12
